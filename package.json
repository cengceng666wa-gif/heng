{
  "name": "heng",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "衡 — 个人减脂与力量训练追踪（自适应 TDEE + 训练计划打卡）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "pnpm build && cap sync android",
    "apk": "pnpm cap:sync && cd android && gradlew.bat assembleDebug",
    "apk:release": "pnpm cap:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "dexie": "^4.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.3"
  }
}
